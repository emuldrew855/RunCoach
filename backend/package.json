{
  "name": "runcoach-backend",
  "version": "1.0.0",
  "description": "Running coach backend with Strava and OpenAI integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node -r dotenv/config scripts/migrate.js",
    "make-admin": "ts-node src/scripts/makeAdmin.ts",
    "backfill:conversations": "ts-node -r dotenv/config src/scripts/backfillConversationEmbeddings.ts",
    "backfill:patterns": "ts-node -r dotenv/config src/scripts/backfillActivityPatterns.ts",
    "backfill:all": "ts-node -r dotenv/config src/scripts/backfillAllMemories.ts",
    "consolidate:memories": "ts-node -r dotenv/config src/scripts/consolidateMemories.ts"
  },
  "keywords": [
    "running",
    "coach",
    "strava",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@openai/agents": "^0.4.5",
    "@types/multer": "^2.0.0",
    "axios": "^1.6.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "openai": "^6.17.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
