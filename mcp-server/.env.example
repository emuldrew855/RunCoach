NODE_ENV=production
PORT=3002
HOST=127.0.0.1
# Azure App Service: HOST=0.0.0.0 and TRUSTED_PROXY_MODE=azure-app-service.
# Azure mode trusts exactly one hop. Use ONLY behind App Service managed ingress,
# with HTTPS Only enabled and ingress replacing X-Forwarded-Proto/For headers.
# Never expose the backend listener directly or use Azure mode on other hosts.
TRUSTED_PROXY_MODE=loopback
# If ingress addresses are known, use TRUSTED_PROXY_MODE=cidrs instead:
# TRUSTED_PROXY_CIDRS=10.0.0.0/24,fd00::/64
DATABASE_URL=postgresql://localhost:5432/runcoach
# shared (default) reuses RunCoach public.users; standalone never uses that table.
STRAVA_CREDENTIAL_STORE=shared
# Required for standalone: canonical base64 of 32 random bytes; store in Key Vault.
# MCP_CREDENTIAL_ENCRYPTION_KEY=
MCP_PUBLIC_URL=https://mcp.example.com
MCP_CLIENT_ID=replace-with-registered-chatgpt-client-id
MCP_CLIENT_SECRET=replace-with-long-random-client-secret
MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
MCP_ALLOWED_ORIGINS=https://chatgpt.com
STRAVA_CLIENT_ID=replace-with-existing-strava-app-client-id
STRAVA_CLIENT_SECRET=replace-with-existing-strava-app-client-secret
# For standalone use a dedicated Strava app, not the existing RunCoach app.
STRAVA_REDIRECT_URI=https://mcp.example.com/strava/callback
